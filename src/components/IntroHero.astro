---
import {profile} from '../data/profile';
import {ui} from '../i18n/ui';

const hasIdentity=profile.en.identity.trim().length>0;
const hasIntroduction=profile.en.introduction.trim().length>0;
---

<section id="welcome" class="intro-hero" aria-labelledby="intro-name">
  <div class="intro-hero__copy">
    {hasIdentity&&(
      <p class="intro-hero__eyebrow" data-lang-group>
        <span data-lang="en">{profile.en.identity}</span>
        <span data-lang="zh" hidden>{profile.zh.identity}</span>
      </p>
    )}
    <h1 id="intro-name" data-lang-group>
      <span data-lang="en">{profile.en.name}</span>
      <span data-lang="zh" hidden>{profile.zh.name}</span>
    </h1>
    {hasIntroduction&&(
      <p class="intro-hero__intro" data-lang-group>
        <span data-lang="en">{profile.en.introduction}</span>
        <span data-lang="zh" hidden>{profile.zh.introduction}</span>
      </p>
    )}
    <nav class="intro-hero__links" aria-label="Introduction links">
      <a class="btn btn--primary" href="#timeline"><span data-lang-group><span data-lang="en">{ui.en.timeline}</span><span data-lang="zh" hidden>{ui.zh.timeline}</span></span></a>
      <a class="btn" href="#about"><span data-lang-group><span data-lang="en">{ui.en.about}</span><span data-lang="zh" hidden>{ui.zh.about}</span></span></a>
      <a class="btn" href="#contact"><span data-lang-group><span data-lang="en">{ui.en.contact}</span><span data-lang="zh" hidden>{ui.zh.contact}</span></span></a>
    </nav>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="shape shape--circle"></div>
    <div class="shape shape--tri"></div>
    <div class="shape shape--sq"></div>
    <div class="shape shape--halftone"></div>
    <div class="stamp">
      <svg viewBox="0 0 100 100">
        <defs>
          <path id="stampCircle" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/>
        </defs>
        <text fill="currentColor" font-size="11" font-family="Space Mono, monospace" letter-spacing="2">
          <textPath href="#stampCircle" xlink:href="#stampCircle">RESEARCH • BUILD • SHIP •</textPath>
        </text>
      </svg>
    </div>
  </div>
</section>
