---
import {profile} from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Lucas Xin" description="About Lucas Xin.">
  <section aria-labelledby="about-heading">
    <h1 id="about-heading" data-lang-group>
      <span data-lang="en">About</span>
      <span data-lang="zh" hidden>关于</span>
    </h1>
    {profile.en.about.map((paragraph,index)=><div data-lang-group>
      <p data-lang="en">{paragraph}</p>
      {profile.zh.about[index]&&<p data-lang="zh" hidden>{profile.zh.about[index]}</p>}
    </div>)}
  </section>
</BaseLayout>
