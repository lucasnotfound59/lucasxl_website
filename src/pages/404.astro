---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Lucas Xin" description="The requested page could not be found.">
  <section class="page-section" aria-labelledby="not-found-heading">
    <h1 id="not-found-heading" class="page-title" data-lang-group>
      <span data-lang="en">Page not found</span>
      <span data-lang="zh" hidden>未找到页面</span>
    </h1>
    <nav class="page-actions" aria-label="Not found navigation">
      <a class="btn" href="/"><span data-lang-group><span data-lang="en">Home</span><span data-lang="zh" hidden>首页</span></span></a>
      <a class="btn" href="/#timeline"><span data-lang-group><span data-lang="en">Timeline</span><span data-lang="zh" hidden>时间线</span></span></a>
    </nav>
  </section>
</BaseLayout>
