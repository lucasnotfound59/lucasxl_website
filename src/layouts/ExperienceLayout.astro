---
import type {PortfolioEntry} from '../lib/content';
import EntryLayout from './EntryLayout.astro';

type Props={
  entry:PortfolioEntry;
  previous?:PortfolioEntry;
  next?:PortfolioEntry;
};

const {entry,previous,next}=Astro.props;
---

<EntryLayout
  entry={entry}
  previous={previous}
  next={next}
  articleClass="experience-entry"
  articleType={{en:'Experience',zh:'经历'}}
>
  <slot name="en" slot="en" />
  <slot name="zh" slot="zh" />
</EntryLayout>
